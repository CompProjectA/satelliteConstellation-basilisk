Installation
# clone repository (top-level)
git clone https://github.com/CompProjectA/satelliteConstellation-basilisk.git
cd satelliteConstellation-basilisk/ProjectWork/BskSim

# virtual environment
python -m venv bskrl-env
# Windows
bskrl-env\Scripts\activate
# macOS/Linux
# source bskrl-env/bin/activate

# dependencies
pip install numpy matplotlib Pillow tensorflow scikit-learn pandas
# optional:
pip install stable-baselines3 shap lime

# check Basilisk import (must be installed per Basilisk docs)
python -c "import Basilisk, sys; print('Basilisk OK:', Basilisk.__path__[0])"


